# Серверная конфигурация. Ключ не передаётся браузеру.
LLM_API_KEY=
# Укажите базовый URL совместимого Chat Completions API без /chat/completions.
LLM_BASE_URL=
# Точный идентификатор модели из документации выбранного провайдера.
LLM_MODEL=
# Необязательно. Для DeepSeek через ChatCI: none; для GPT сверяйте допустимые значения с провайдером.
LLM_REASONING_EFFORT=
